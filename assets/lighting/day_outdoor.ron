// 「户外日光」光照主题。
// dir = 光传播方向（指向场景，打包时翻转为 L 指向光）；angular_radius_deg = 太阳盘角半径（度）；
// ambient 为线性空间环境光，exposure = 曝光系数；sky = 天空纯色 #78A7FF。
(
  sun: Some((
    dir: (0.5, -0.8, 0.3),
    angular_radius_deg: 3.0,
    color: (1.0, 0.96, 0.88),
    intensity: 0.8,
  )),
  points: [],
  ambient: (0.08, 0.09, 0.12),
  exposure: 1.0,
  sky: Some((
    color: (0.47, 0.65, 1.0),
  )),
)
