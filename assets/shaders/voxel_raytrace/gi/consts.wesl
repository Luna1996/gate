/// 逐 (体素,面) 辐照度缓存（新 GI 路径）与着色共用的常量。
/// 缓存自身的容量 / 布局常量在 `gi/cache.wesl`，这里只放着色与光路要用的旋钮。

/// 探索射线 / 阴影射线的 t 上限（voxel）。
const GI_T_MAX: f32 = 8192.0;
/// GI 射线没打到几何时注入的天空辐亮度系数（`gi_cache_update` 的 miss 分支）；
/// 1.0 = `sky_rgb()` 原样注入。
const GI_SKY_RADIANCE_SCALE: f32 = 1.0;
/// 缓存射线命中面的**直射太阳**项增益（`gi_cache_update`：`alb · sun_c · ndl · sun · 本值`）。
/// 这是 GI 唯一的**直射**光源 —— 没有它，任何看不到天空的表面（草丛根部、过道内墙、阴影地面）
/// 都只能自洽地维持全黑，加密条目也救不回来。语义与着色侧直射项一致（不含 1/π）。
const GI_SUN_BOUNCE: f32 = 1.0;
/// 命中自发光体素时的辐亮度增益（albedo · emissive · 本值）；1.0 = 不额外放大。
const GI_EMIT_GAIN: f32 = 1.0;
const GI_PI: f32 = 3.14159265;
/// RIS 权重的亮度投影（Rec.709）：抽样概率与 `w_sum` 都是标量，取权重的亮度投影做标量化。
const GI_LUMA: vec3<f32> = vec3<f32>(0.2126, 0.7152, 0.0722);

// ---- 屏幕空间逐面 ReSTIR（`gi/screen.wesl`，`GI_CACHE_ON = false` 时的主路径）----
/// reservoir 的候选数上限 M：`w_sum` 与 M 同比例缩回（`w_sum / M` 不变）⇒ 抑制历史对抽样的支配。
/// 屏幕空间路径每帧进 1（新鲜）+ ≤1（时域重连接）+ ≤4（同键空间并）个候选，
/// 取 32 ≈ 8~10 帧的记忆；与旧缓存路径的 `GI_CACHE_M_CAP` 同值同义。
const GI_SS_M_CAP: u32 = 32u;
// ---- GI 降噪（`gi/denoise.wesl`：时域累积 + 迭代 atrous 两段 pass）----
// 目标：把屏幕空间 GI 路的噪声压到静态无噪，同时**不引入 ramp、不跨薄板、不糊掉逐体素平味**。
// 权威值都在这里；Rust 需要的那几个经 `wesl_consts.rs` 的 `REQUIRED` 解析（只认 u32 字面量）。
/// 导引缓冲每像素字数：面键（2）+ 命中体素中心世界位置（3）+ 法线八面体打包（1）
/// + 上帧重投影像素坐标（1）+ 平面检验容差（1）。`gi_main` 写，时域与空间两段读。
/// 容差（= `GI_DEN_PLANE_K` × 该体素世界边长）**在写导引时算好**，是为了让两个降噪 pass 的
/// pipeline layout 只需要 group(0) 一份（否则 `make_grid` 会把 `grid_descs`(@group(2)) 拖进来）。
const GI_DEN_GUIDE_WORDS: u32 = 8u;
/// 历史缓冲每像素字数：累积色 rgb（3）+ 亮度一阶矩（1）+ 二阶矩（1）+ 历史长度 M（1）+ 面键（2）。
const GI_DEN_HIST_WORDS: u32 = 8u;
/// 导引 word 布局下标。
const GI_DEN_G_KEY0: u32 = 0u;
const GI_DEN_G_KEY1: u32 = 1u; // bit15 = 有效位（面只占 13..15 的 3 bit，值 ≤ 5 ⇒ bit15 空闲）
const GI_DEN_G_POS: u32 = 2u; // 2..5 = 世界位置 xyz
const GI_DEN_G_NRM: u32 = 5u;
const GI_DEN_G_PREV: u32 = 6u; // x | y<<16；0xFFFFFFFF = 没有上帧对应像素
const GI_DEN_G_TOL: u32 = 7u; // 平面深度检验容差（世界单位，f32）
/// 导引有效位（`GI_DEN_G_KEY1` 的 bit15）。
const GI_DEN_G_VALID: u32 = 0x8000u;
/// 历史 word 布局下标。
const GI_DEN_H_COL: u32 = 0u; // 0..3 = 累积色 rgb
const GI_DEN_H_M1: u32 = 3u;
const GI_DEN_H_M2: u32 = 4u;
const GI_DEN_H_M: u32 = 5u;
const GI_DEN_H_KEY0: u32 = 6u;
const GI_DEN_H_KEY1: u32 = 7u;
/// atrous 迭代次数（步长依次 1/2/4，足迹 = 半分辨率 7 像素半径）。Rust 侧按本值派发。
const GI_DEN_ATROUS_ITER: u32 = 3u;
/// 时域累积的历史长度上限 M（帧）。M 封顶后历史权重上限 = (M−1)/M = 95/96 ≈ 0.9896
/// ⇒ 稳态是「等权滑动平均 + 1/96 新信息」，几何/光照一变**当帧**就能跟上（不无限累积：
/// 面键逐位相等判定负责几何变化、AABB 钳制负责颜色变化，两者都不依赖 M 的大小）。
/// 95/96 的由来：AR(1) 低通的白噪声方差比 = (1−w)/(1+w) ⇒ 残余 σ 比 = sqrt(1/191) = 7.2%。
/// 实测：M = 48 时静态逐帧闪烁只剩 13.2%（目标 ≤10%），M = 96 再压一档；
/// 而 M 再往上（192+）收益递减（flicker ∝ 1/√M）且「面内均值变化」响应变钝，故取 96。
const GI_DEN_M_MAX: u32 = 96u;
/// 方差驱动的历史权重：`w_var = clamp(σ_α / σ, W_HIST_MIN, 1)`。
/// σ = 本帧 3×3 邻域里**同面键** tap 的亮度标准差（同一个面内的差异**只可能是噪声**；
/// 换成「共面邻域」会把相邻体素的真实差异误当噪声，实测静态时间 σ 只降到 27%）。
/// σ_α = 0.02（本工程 GI 的量级：gi_out ≈ ⟨L⟩，面内噪声 σ ≈ 0.005~0.01）。
/// σ 大 ⇒ w_var 小 ⇒ 靠本帧（不拖影）；σ ≪ σ_α ⇒ w_var = 1 ⇒ 纯累积（静态收敛）。
const GI_DEN_SIGMA_ALPHA: f32 = 0.02;
/// 历史权重下限：压低但不清零（抗 flicker；真正的「历史作废」由面键逐位相等判定，不走这里）。
const GI_DEN_W_HIST_MIN: f32 = 0.05;
/// 3×3 颜色钳制（anti-ghosting 标配）：历史色被钳到「本帧同几何邻域均值 ± K × 标准差」。
const GI_DEN_CLAMP_K: f32 = 2.5;
/// 法线相似阈值：`dot(n_nbr, n_center) < 本值` ⇒ 硬拒。
/// 1 体素薄板的另一侧法线 = −n ⇒ dot = −1，被这条直接拒掉。
const GI_DEN_N_DOT: f32 = 0.9;
/// 平面深度检验容差系数：`|(p_nbr − p_center)·n_center| < K × 中心体素世界边长`。
/// 导引存的是**命中体素中心**（不是射线命中点）⇒ 同一面 / 同一平面上的相邻体素该内积**恰好为 0**，
/// 而「1 体素薄板的另一侧」该内积 = 1 个世界边长 ⇒ K = 0.5 精确地把另一侧拒掉（不靠距离相关的
/// 深度容差，远处薄板也不会因为像素足迹变大而漏）。
const GI_DEN_PLANE_K: f32 = 0.5;
/// 亮度 range 权重：`exp(-|Δluma| / φ)`，φ = 本值 × σ_n（σ_n 同上，由**本帧同面键**邻域给出）。
/// 这条只作用于**不同面键**的 tap（同面键满权重，见 `gi/denoise.wesl`）。
/// 取 1.0（= φ 就是面内噪声 σ）：跨体素邻居的典型亮度差（实测平面 σ ≈ 0.016，相邻体素差 ~0.01）
/// 会得到 w ≈ exp(-0.01/0.0045) ≈ 0.1 ⇒ 跨面注入几乎关掉。取 3.0 时 w ≈ 0.48，atrous 会把邻居体素的
/// 值混进面内 ⇒ 面内被「糊出梯度」（实测面内空间 σ 卡在 28~30% 下不去）。这直接对应
/// 「逐体素平坦、不允许把体素面糊成渐变」这条硬约束。
const GI_DEN_LUMA_K: f32 = 1.0;

/// 天光环境项：缓存没有数据（`cov = 0`）时兜底。
const GI_SKY_AMBIENT: f32 = 0.05;
/// 天光常量的地板：`cov = 1`（缓存有数据）时保留 k 倍这一项。
/// 必须写成 `mix(1.0, GI_AMBIENT_FLOOR, cov)`（语义 `1 - (1-k)·cov`）。
const GI_AMBIENT_FLOOR: f32 = 0.01;
/// 着色点从体素表面再外推的量（体素）。
/// 必须与 Rust `brickmap::dda::wgsl_consts::SHADOW_SURFACE_EPS` 一致。
const SHADOW_SURFACE_EPS: f32 = 0.03125;
// 局部脏区（编辑体素）失效：条目位置落在脏盒（世界 voxel AABB）外扩「该盒自带余量」内即视为失效。
// 权威值 = 下面的 `GI_CACHE_DIRTY_MARGIN_VOXELS`（Rust `gi.rs` 经 `wesl_consts.rs` 解析同一份源码）。
// 逐盒余量由 Rust 算好写进 uniform / `gi_dirty_boxes`（因为物体 volume 要按 scale 放大）：
// 主世界（scale = 1）= 基准值；物体 volume = `max(基准, 基准 × scale)`
// —— 局部 2 格在缩放后的物体里对应 `2·scale` 格世界空间。取 > 0 是必须的：一个体素的变更会改变
// 邻近面接到的光，而条目位置在体素表面外推约半格。
/// 脏盒失效余量的基准值（voxel）。Rust 侧不得另留副本（`wesl_consts.rs` 会 fail-fast）。
const GI_CACHE_DIRTY_MARGIN_VOXELS: u32 = 2u;
/// 更新调度的「可见优先」：可见段占更新预算的百分比（线程数 = `GI_CACHE_UPDATE_BUDGET × 本值 / 100`）。
///
/// **保持 50（开）** —— 依据是**同机位、同流程**的 A/B（固定相机存档、各跑 75 s、取稳态后 12 个样本）：
/// - `share = 50`：`gate_gi_cache_update` **0.40~0.48 ms**（样本极稳）
/// - `share = 0`：**1.3~2.3 ms**（且从启动的 0.7 一路爬上去）
/// ⇒ 可见优先**更快约 3×**。原因是**显存访问局部性**，不是射线数量：可见条目刚被着色 pass 读过、
/// 还在缓存里（热），而整表轮转扫的是 1M 槽位上的分散条目（冷 miss）。
/// 两段的射线总量接近（都受「收敛降频」约束），差别主要在访存。
///
/// 教训（写下来避免再踩）：这个 A/B **必须同机位、同流程**。曾有一次跨进程/不同机位的对照得出
/// "share=0 更快"的相反结论，那个结论不可信；`gate_gi_cache_update` 的绝对耗时强依赖场景状态
/// （填充期大量条目 `n < GI_CACHE_CONVERGED_N`、不降频，可到 2 ms 以上；稳态降回 0.4 ms 量级）。
///
/// 因此**不要再**把这里置 0 当作"省预算"手段；要再优化就针对「填充期不降频」那一段。
const GI_CACHE_VISIBLE_SHARE: u32 = 50u;
/// 更新调度的「收敛降频」阈值：条目累积样本数 `n ≥ 本值` 视为已收敛，每 4 帧才更新一次。
/// **可见段与轮转段都适用**（可见段不降频会让预算被反复花在已收敛的可见条目上）；
/// 未收敛 / 刚新建 / 世代过期 / 脏区的条目 `n` 很小或被重置 ⇒ 不降频，优先拿到预算。
/// 64 的取法：半分辨率下一帧 4 个候选，约 16 帧的量级 —— 大到足以让降频真正省出预算，
/// 又远小于「肉眼可见地收敛」所需的帧数，降频后画面不会回退。
const GI_CACHE_CONVERGED_N: u32 = 64u;

// ---- 条目回收（有界工作集）----
// 分配游标只增不减 ⇒ 飞行十几屏新地形就把 GI_CACHE_SLOTS 耗光，之后新露出的面永远建不出条目
// （着色侧拿不到缓存 ⇒ 退化成天光兜底，开/关 GI 画面一致且不可恢复）。
// 回收把缓存变成「有界工作集」：把「久未露面」的条目还给空闲链表，由新条目复用。
// 布局：`gi_cache_state[1]` = 空闲链表头（存「下标 + 1」，0 = 空）；链指针复用被回收条目自己的
// word[0]（键），见 `gi/cache.wesl` 的 `GI_CACHE_FREE_BIT`。
/// 条目「最近一次被着色侧 claim 的帧」比当前帧早超过本值（帧）即视为死条目，可被回收。
/// 300 帧 ≈ 5 s（60 fps）：远大于整表轮转的帧数（`GI_CACHE_SLOTS` / 轮转段线程数 = 32），
/// 所以「正要收敛」的条目不会被误杀。
const GI_CACHE_EVICT_AGE: u32 = 300u;
/// 回收水位（占 `GI_CACHE_SLOTS` 的百分比）：分配游标达到本比例后才允许回收。
/// 低于水位说明缓存还宽裕（启动填充期），此时回收只会白白增加分配/重收敛开销。
const GI_CACHE_EVICT_AT: u32 = 75u;
/// 饥饿态（分配游标已越过容量 ⇒ 新条目正在失败）下的回收年龄门槛（帧）。
/// 只用 `GI_CACHE_EVICT_AGE` 时，「表里全是年轻条目」会让回收几乎失效：实测快速飞行下
/// 年龄 > 300 帧的条目只剩 863 个，回收成功率 2%，覆盖率在 55~95% 之间抖动。
/// 取 32 = 整表轮转一遍的帧数（`GI_CACHE_SLOTS` / 轮转段线程数）—— 被采样过的条目每帧都会被
/// claim，所以「连续 32 帧没被 claim」等价于「已经不在可见工作集里」，可以安全让位给新面。
const GI_CACHE_EVICT_STARVE_AGE: u32 = 32u;
