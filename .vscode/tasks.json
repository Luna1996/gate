{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-gate-app",
      "type": "shell",
      "command": "cargo",
      "args": [
        "build",
        "--release",
        "-p",
        "gate-app"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$rustc"
      ]
    }
  ]
}