{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-gate-app-fast",
      "type": "shell",
      "command": "cargo",
      "args": [
        "build",
        "--profile",
        "build-fast",
        "-p",
        "gate-app"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
    },
    {
      "label": "build-gate-app-balance",
      "type": "shell",
      "command": "cargo",
      "args": [
        "build",
        "--profile",
        "balance",
        "-p",
        "gate-app"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
    },
    {
      "label": "build-gate-app-run-fast",
      "type": "shell",
      "command": "cargo",
      "args": [
        "build",
        "--profile",
        "run-fast",
        "-p",
        "gate-app"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
    },
    {
      "label": "package-gate-app",
      "type": "shell",
      "command": "package.sh",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
    }
  ]
}