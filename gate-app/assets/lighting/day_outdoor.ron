// 「户外日光」光照主题（P3.5a + 3.4 配套）
// 太阳方向 = 光传播方向（指向场景，打包时翻转为 L 指向光）；
// dir.y < 0 → 太阳在地平线以上（光从上往下照）；y = -0.8 ≈ 53° 仰角（下午斜阳）；
// angular_radius_deg = 太阳盘角半径（保留字段，硬阴影方案不使用）；
// ambient/exposure 为线性空间常数项；sky = 纯色（Minecraft 白天平原天空 #78A7FF）；
// 无点光——室外自然光由太阳 + 天空环境光主导。
(
  sun: Some((
    dir: (0.5, -0.8, 0.3),
    angular_radius_deg: 3.0,
    color: (1.0, 0.96, 0.88),
    intensity: 0.8,
  )),
  points: [],
  ambient: (0.08, 0.09, 0.12),
  exposure: 1.0,
  sky: Some((
    color: (0.47, 0.65, 1.0),
  )),
)
